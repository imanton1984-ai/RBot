[2m2026-03-21T21:36:57.950615Z[0m [33m WARN[0m [2msqlx::query[0m[2m:[0m slow statement: execution time exceeded alert threshold [3msummary[0m[2m=[0m"WITH candle_stats AS ( …" [3mdb.statement[0m[2m=[0m"\n\n\n            WITH candle_stats AS (\n                SELECT symbol,\n                       COUNT(*) as total_candles,\n                       MAX(time_ms) as last_candle_ms\n                FROM market.candles_15m\n                GROUP BY symbol\n                HAVING COUNT(*) > 0\n            ),\n            indicator_stats AS (\n                SELECT symbol,\n                       MAX(time_ms) as last_indicator_ms\n                FROM market.indicators_wide\n                WHERE tf_minutes = $1\n                GROUP BY symbol\n            )\n            SELECT\n                c.symbol,\n                CASE\n                    WHEN i.last_indicator_ms IS NULL THEN c.total_candles\n                    WHEN c.last_candle_ms > i.last_indicator_ms THEN\n                        GREATEST(1, (c.last_candle_ms - i.last_indicator_ms) / $2)\n                    ELSE 0\n                END as gap_candles\n            FROM candle_stats c\n            LEFT JOIN indicator_stats i ON c.symbol = i.symbol\n            WHERE i.last_indicator_ms IS NULL\n               OR c.last_candle_ms > i.last_indicator_ms\n            \n" [3mrows_affected[0m[2m=[0m71 [3mrows_returned[0m[2m=[0m71 [3melapsed[0m[2m=[0m1.463614675s [3melapsed_secs[0m[2m=[0m1.463614675 [3mslow_threshold[0m[2m=[0m1s
