[2m2026-02-25T15:48:51.423549Z[0m [33m WARN[0m [2msqlx::query[0m[2m:[0m slow statement: execution time exceeded alert threshold [3msummary[0m[2m=[0m"WITH candle_range AS ( …" [3mdb.statement[0m[2m=[0m"\n\n\n        WITH candle_range AS (\n            SELECT \n                MIN(time) as first_candle,\n                MAX(time) as last_candle,\n                COUNT(*) as total_candles\n            FROM market.candles_1d \n            WHERE symbol = $1\n        ),\n        indicator_range AS (\n            SELECT MAX(time) as last_indicator\n            FROM market.indicators_wide \n            WHERE symbol = $1 AND tf_minutes = $2\n        )\n        SELECT \n            cr.total_candles,\n            cr.first_candle,\n            cr.last_candle,\n            ir.last_indicator,\n            CASE\n                WHEN cr.total_candles = 0 THEN 0\n                WHEN ir.last_indicator IS NULL THEN cr.total_candles\n                ELSE (\n                    SELECT COUNT(*) FROM market.candles_1d c\n                    WHERE c.symbol = $1 AND c.time > ir.last_indicator\n                )\n            END as gap_candles\n        FROM candle_range cr, indicator_range ir\n        \n" [3mrows_affected[0m[2m=[0m1 [3mrows_returned[0m[2m=[0m1 [3melapsed[0m[2m=[0m1.028089511s [3melapsed_secs[0m[2m=[0m1.028089511 [3mslow_threshold[0m[2m=[0m1s
