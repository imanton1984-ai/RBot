DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=timescaledb_binance 
DB_PORT=5433 
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/timescaledb_binance 
RP_KAFKA_PORT=19092 
RP_ADMIN_PORT=9644 
RP_CONSOLE_PORT=8080 
MARKET_INGEST_PORT=9001 
SVC_HEALTH_PORT=9005 
COMPUTE_CORE_PORT=9010 
API_GATEWAY_PORT=9080 
ORDER_ENGINE_PORT=9020 
POSITION_TRACKER_PORT=9030 
WEBGUI_PORT=9040
TOPIC_CANDLES_CLOSE=candles.close
TOPIC_INDICATORS_CLOSE=indicators.close
TOPIC_CANDLES_LIVE=candles.live
TOPIC_PAIRS=market.pairs
TOPIC_RAW_SIGNALS=trade.raw_signals

# health
CONNECTIONS_HEALTH_ADDR=0.0.0.0:18080
CONNECTIONS_CHECK_SEC=20
WS_FRESH_SEC=30

# binance ws
BINANCE_WS_BASE_URL=wss://fstream.binance.com/stream
BINANCE_WS_STREAMS=btcusdt@trade,ethusdt@trade,btcusdt@kline_1m
BINANCE_WS_PING_SEC=20

# kafka/redpanda
KAFKA_BROKERS=127.0.0.1:19092
TOPIC_MARKET_WS_RAW=market.ws.raw
WRITER_GROUP=ingestor
KAFKA_TOPIC_PREFIX=

# capacity
WS_RAW_CHANNEL_CAP=50000

export INGEST_SYNC_COMMIT_OFF=1
export INGEST_COPY_FLUSH_ROWS=60000
export INGEST_COPY_FLUSH_MS=120
export INGEST_WRITER_CHAN=100000
export INGEST_WS_MAX_STREAMS=20

# live candle write frequency (db upsert)
export BOT__RUNTIME__PERSIST_LIVE_CANDLE=true
export BOT__RUNTIME__PERSIST_LIVE_CANDLE_EVERY_MS=2000   # 2s (хочешь 3s — ставь 3000)

# optional: защита от потока intra-update (чтобы не спамить каналами)
export BOT__RUNTIME__INTRA_UPDATE_SAMPLING_MS=200        # уже есть в runtime.toml, можно оверрайдить

# compute service
COMPUTE_MIN_BARS_READY=250
COMPUTE_REQUIRED_LOOKBACK=1000
COMPUTE_WARMUP_BARS=100

RAW_SIGNALS_ENABLE_FILTERING=false
RAW_SIGNALS_MIN_SCORE=0.0